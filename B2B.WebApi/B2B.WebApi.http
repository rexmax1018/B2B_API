@B2B.WebApi_HostAddress = http://localhost:5173
@B2B.WebApi_LoginPassword = <password>

GET {{B2B.WebApi_HostAddress}}/Health
Accept: application/json

###

POST {{B2B.WebApi_HostAddress}}/api/auth/login
Content-Type: application/json

{
  "account": "admin",
  "password": "{{B2B.WebApi_LoginPassword}}"
}

###

POST {{B2B.WebApi_HostAddress}}/api/auth/refresh-token
Content-Type: application/json

{
  "refreshToken": "<refresh-token>"
}

###

POST {{B2B.WebApi_HostAddress}}/api/auth/logout
Content-Type: application/json

{
  "refreshToken": "<refresh-token>"
}
